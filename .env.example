# API database connection; use your MongoDB Atlas URI for deployment.
MONGODB_URI=mongodb://127.0.0.1:27017/claro_visa

# API server port for local development.
PORT=4000

# Optional fixed date override for local demo data; normally leave unset.
# TODAY=

# Public API base URL used by the Expo app. Leave empty for demo mode.
# For local web development: http://localhost:4000
# For deployed builds: https://your-api-domain.example
EXPO_PUBLIC_API_URL=
